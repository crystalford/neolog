# Supabase - get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Required: for server-side operations
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Your site URL (change for production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend) - Get API key from resend.com
# Required for: subscription confirmations, new post notifications, weekly digests
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Neolog <noreply@yourdomain.com>

# WebSub Hub (optional) - For real-time RSS push notifications
WEBSUB_HUB_URL=https://pubsubhubbub.appspot.com

# Stripe - For paid subscriptions, tips, and payouts
STRIPE_SECRET_KEY=sk_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_xxxxxxxxxxxx

# Cron Secret - Random string to secure cron endpoints
CRON_SECRET=your_random_secret_string
